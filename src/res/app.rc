// ============================================================================
//  app.rc - YiImageBig 资源: 版本信息 / 图标 / 清单
// ============================================================================
#include <windows.h>

#define APP_VER_STR "1.0.0"
#define APP_VER_NUM 1,0,0,0

1 ICON "app.ico"

// ---------------------------------------------------------------------------
// 清单: comctl32 v6 + PerMonitorV2 DPI
// ---------------------------------------------------------------------------
1 RT_MANIFEST "app.manifest"

// ---------------------------------------------------------------------------
// 版本信息
// ---------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VER_NUM
 PRODUCTVERSION APP_VER_NUM
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "YiImageBig"
            VALUE "FileDescription",  "YiImageBig 图片超分工具 (RealESRGAN x4)"
            VALUE "FileVersion",      APP_VER_STR
            VALUE "InternalName",     "YiImageBig"
            VALUE "LegalCopyright",   "YiImageBig"
            VALUE "OriginalFilename", "YiImageBig.exe"
            VALUE "ProductName",      "YiImageBig"
            VALUE "ProductVersion",   APP_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
